# Copy to .env and fill in. Values come from the Azure AI Foundry resource
# (Azure portal -> resource -> Keys and Endpoint). Never commit .env.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=<key>
AZURE_OPENAI_API_VERSION=2024-10-21
# Deployment names (high-volume agents / Analyst)
AZURE_OPENAI_DEPLOYMENT_FAST=gpt-4.1-mini
AZURE_OPENAI_DEPLOYMENT_SMART=gpt-4o
# Agent-output cache (per match, moment and viewer profile). 0 disables; default dir is <data>/cache
MATCHMIND_CACHE=1
# MATCHMIND_CACHE_DIR=/data/cache
# Commentator voice: Azure AI Speech. The Foundry resource is multi-service, so its key works; only the region is needed.
# AZURE_SPEECH_KEY overrides the key if Speech lives in another resource.
AZURE_SPEECH_REGION=eastus2
# Commentator voices (any name from the region's voice list). Defaults: es-MX-Alejo:MAI-Voice-2 (excited), en-GB-Ryan:DragonHDLatestNeural
# MATCHMIND_VOICE_ES=es-AR-TomasNeural
# MATCHMIND_VOICE_EN=en-GB-Ryan:DragonHDLatestNeural
