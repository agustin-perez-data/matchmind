# Copy to .env and fill in. Never commit .env.
#
# How the agents reach Microsoft Foundry (first match wins):
#   1. FOUNDRY_PROJECT_ENDPOINT   keyless through the Foundry project (DefaultAzureCredential: managed identity on
#                                 Azure, `az login` locally). This is how the deployed app runs; traces and
#                                 evaluations land in the same project.
#   2. AZURE_OPENAI_ENDPOINT + AZURE_OPENAI_API_KEY   the account endpoint with a key (local fallback).
#   3. AZURE_OPENAI_ENDPOINT + MATCHMIND_AUTH=identity   the account endpoint, keyless.
# FOUNDRY_PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<project>
AZURE_OPENAI_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=<key>
# MATCHMIND_AUTH=identity
AZURE_OPENAI_API_VERSION=2024-10-21
# Telemetry: when set, agent runs, tool calls, the per-moment span and the matchmind.* metrics go to Application
# Insights (and so to the Foundry project's Traces page). Prompts are never exported.
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...
# Deployment names (high-volume agents / Analyst)
AZURE_OPENAI_DEPLOYMENT_FAST=gpt-4.1-mini
AZURE_OPENAI_DEPLOYMENT_SMART=gpt-4o
# Agent-output cache (per match, moment and viewer profile). 0 disables; default dir is <data>/cache
MATCHMIND_CACHE=1
# MATCHMIND_CACHE_DIR=/data/cache
# Commentator voice: Azure AI Speech. The Foundry resource is multi-service, so its key works; only the region is needed.
# AZURE_SPEECH_KEY overrides the key if Speech lives in another resource.
AZURE_SPEECH_REGION=eastus2
# Commentator voices (any name from the region's voice list). Defaults: es-MX-Alejo:MAI-Voice-2 and en-US-Ethan:MAI-Voice-2, both always in the excited style
# MATCHMIND_VOICE_ES=es-AR-TomasNeural
# MATCHMIND_VOICE_EN=en-GB-Ryan:DragonHDLatestNeural
